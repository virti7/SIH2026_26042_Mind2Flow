{
  "id": "bilingual_worksheet_v1",
  "version": 1,
  "description": "Colourful interactive bilingual worksheet (screen) + black & white print layout. Placeholders in {braces} are filled from the worksheet document's meta.",
  "layout": {
    "two_column_min_width": 600,
    "print_width": 820,
    "block_span": {
      "mcq": 1,
      "fill_blank": 1,
      "order_match": 1,
      "match_pairs": 1,
      "write": 1,
      "trace": 2
    }
  },
  "header": {
    "lines": [
      { "text": "Class {grade}  ·  {subject}", "style": "title" },
      { "text": "Worksheet {number} · {topic}", "style": "subtitle" },
      { "text": "{title_source}", "style": "heading" },
      { "text": "{title_target}", "style": "heading_accent" }
    ]
  },
  "student_info": {
    "left": [
      { "labels": { "hi": "विद्यार्थी का नाम:", "en": "Student's Name:" }, "blank": true },
      { "labels": { "hi": "कक्षा:", "en": "Class:" }, "values": { "hi": "{grade}", "en": "{grade}" } }
    ],
    "right": [
      { "labels": { "hi": "रोल नंबर:", "en": "Roll Number:" }, "blank": true },
      { "labels": { "hi": "विषय:", "en": "Subject:" }, "values": { "hi": "{subject_hi}", "en": "{subject}" } }
    ]
  },
  "footer": {
    "left": { "labels": { "hi": "शिक्षक के हस्ताक्षर:", "en": "Teacher's Signature:" }, "blank": true },
    "right": { "labels": { "hi": "दिनांक:", "en": "Date:" }, "date_blank": "____ / ____ / 20____" }
  },
  "block_headings": {
    "fill_blank": { "hi": "रिक्त स्थान भरें", "en": "Fill in the missing number." },
    "write": { "hi": "उत्तर लिखें", "en": "Write the answer." },
    "trace": { "hi": "नीचे दी गई संख्याओं को ट्रेस करें", "en": "Trace the numbers below." }
  },
  "question_type_map": {
    "multiple_choice": "mcq",
    "counting": "mcq",
    "tens_ones": "mcq",
    "matching": "mcq",
    "reading": "mcq",
    "practice": "mcq",
    "fill_blank": "fill_blank",
    "writing": "write"
  },
  "labels": {
    "check": { "hi": "जाँचें", "en": "Check" },
    "reset": { "hi": "फिर से", "en": "Reset" },
    "correct": { "hi": "शाबाश! सही उत्तर", "en": "Well done! Correct" },
    "try_again": { "hi": "फिर से कोशिश करें", "en": "Try again" },
    "tap_to_match": { "hi": "बाईं ओर टैप करें, फिर दाईं ओर", "en": "Tap left, then right to match" },
    "tap_to_trace": { "hi": "ट्रेस करने के लिए टैप करें", "en": "Tap a number to trace it" },
    "answer_hint": { "hi": "यहाँ लिखें", "en": "Write here" }
  },
  "themes": {
    "colorful": {
      "page_bg": "#FFFFFF",
      "header_bg": "#FFF9E8",
      "header_blobs": ["#FFD76A", "#BFE5C4"],
      "ink": "#1F2A44",
      "muted": "#4B5563",
      "accent": "#1B7A3E",
      "info_bg": "#EEF6FF",
      "info_border": "#B8D5F2",
      "footer_bg": "#EEF0FF",
      "footer_border": "#C7CCF5",
      "tile_bg": "#FFFFFF",
      "correct": "#1B7A3E",
      "wrong": "#D64545",
      "blocks": [
        { "bg": "#FFF4E8", "border": "#FFD9B0", "badge": "#F7931E" },
        { "bg": "#EAF3FF", "border": "#BDD8F6", "badge": "#2F6FE4" },
        { "bg": "#EDF7EC", "border": "#C4E3C2", "badge": "#3E9B48" },
        { "bg": "#FFF8E2", "border": "#F7E2A6", "badge": "#F4B400" },
        { "bg": "#FFECEE", "border": "#F7C3CA", "badge": "#E4566B" },
        { "bg": "#F2EEFF", "border": "#D3C8F7", "badge": "#7B61D9" }
      ]
    },
    "print": {
      "page_bg": "#FFFFFF",
      "header_bg": "#FFFFFF",
      "header_blobs": [],
      "ink": "#000000",
      "muted": "#000000",
      "accent": "#000000",
      "info_bg": "#FFFFFF",
      "info_border": "#000000",
      "footer_bg": "#FFFFFF",
      "footer_border": "#000000",
      "tile_bg": "#FFFFFF",
      "correct": "#000000",
      "wrong": "#000000",
      "blocks": [
        { "bg": "#FFFFFF", "border": "#000000", "badge": "#FFFFFF", "badge_outline": true }
      ]
    }
  }
}
