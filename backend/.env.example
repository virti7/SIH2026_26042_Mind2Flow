# Environment Configuration for Maatribhasha FastAPI Backend
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# CORS: browser (Flutter Web) origins allowed to call this API.
# - Local dev default in code is ["*"] which browsers accept for
#   non-credentialed requests (the Flutter app sends no cookies).
# - `flutter run -d chrome` serves the app from http://localhost:<random-port>,
#   so it is covered by the default.
# - For credentialed production deployments, replace "*" with explicit origins
#   (JSON list; "*" is rejected by browsers when credentials are used):
# BACKEND_CORS_ORIGINS=["https://your-frontend-host","http://localhost:8080"]

# Database Configuration (Supabase PostgreSQL / Local Fallback)
# For Supabase production:
# DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# For local development/testing:
DATABASE_URL=sqlite+aiosqlite:///./maatribhasha_backend.db

# Supabase Auth & Project Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy_anon_key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy_service_role_key
SUPABASE_JWT_SECRET=super-secret-jwt-key-min-32-chars-long
# JWKS-based verification for real Supabase ES256 tokens.
# Derived automatically from SUPABASE_URL when unset:
#   {SUPABASE_URL}/auth/v1/.well-known/jwks.json
# SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
# SUPABASE_JWT_AUDIENCE=authenticated

# Supabase Storage Buckets
STORAGE_BUCKET_LANGUAGE_PACKS=language-packs
STORAGE_BUCKET_MODELS=models
STORAGE_BUCKET_CONTENT=content
# Optional dedicated buckets; default to STORAGE_BUCKET_CONTENT when unset.
# Confirm actual bucket names in the Supabase dashboard before overriding.
# STORAGE_BUCKET_GENERATED_RESOURCES=content
# STORAGE_BUCKET_WORKSHEETS=content
# STORAGE_BUCKET_FLASHCARDS=content

# Server-Side GenAI & Bilingual Generator Configuration
# Required for live LLM generation; Mock provider is used in local dev/tests if omitted
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash
SARVAM_API_KEY=your-sarvam-api-key-here
SARVAM_MODEL=sarvam-105b
BILINGUAL_GENERATOR_DIR=generator
# Sarvam Translation API (SERVER ONLY - never expose to Flutter)
# SARVAM_BASE_URL defaults to https://api.sarvam.ai
# SARVAM_TRANSLATE_MODEL=sarvam-translate:v1
# SARVAM_TRANSLATE_LANGUAGES=en-IN,hi-IN,bn-IN,gu-IN,kn-IN,ml-IN,mr-IN,od-IN,pa-IN,ta-IN,te-IN,sat-IN
# Custom NMT endpoints / glossaries for Ho (ho) and Mundari (unr).
# HO_NMT_ENDPOINT=https://your-nmt-host/translate
# MUNDARI_NMT_ENDPOINT=https://your-nmt-host/translate
# HO_GLOSSARY_PATH=/path/to/ho_glossary.json
# MUNDARI_GLOSSARY_PATH=/path/to/mundari_glossary.json
# Approved local-context library for contextual worksheets (optional).
# WORKSHEET_LOCAL_CONTEXT_PATH=/path/to/local_contexts.json
